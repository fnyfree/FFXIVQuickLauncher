<UserControl x:Class="XIVLauncher.Windows.Main.Slides.DCTravelProgressSlide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="240">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Windows/Main/LoginCardSlideResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,0,24,0" VerticalAlignment="Center">
        <StackPanel>
            <Grid Margin="0,0,0,20"
                  Width="80"
                  Height="80"
                  HorizontalAlignment="Center"
                  Visibility="{Binding DCTravelPage.IsTravelInProgress, Converter={StaticResource BoolToVis}}">
                <!-- 永续动画跟随 IsVisible 启停 (Transitioner 未选中的页仅 Hidden 不卸载),
                     并用 ScaleTransform 代替 Width/Height 以避免每帧布局 -->
                <Ellipse Fill="{DynamicResource MaterialDesign.Brush.Primary}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" Width="48" Height="48"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="PulseEllipseBegin">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="1" To="1.667" Duration="0:0:1.5"
                                                                 AutoReverse="True" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="1" To="1.667" Duration="0:0:1.5"
                                                                 AutoReverse="True" />
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.35" Duration="0:0:1.5"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="PulseEllipseBegin" />
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <materialDesign:PackIcon Kind="Rocket" Width="24" Height="24"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
            </Grid>

            <materialDesign:PackIcon Width="48"
                                     Height="48"
                                     Margin="0,0,0,20"
                                     HorizontalAlignment="Center">
                <materialDesign:PackIcon.Style>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Kind" Value="AlertCircle" />
                        <Setter Property="Foreground" Value="IndianRed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DCTravelPage.IsTravelInProgress}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DCTravelPage.IsTravelSuccessful}" Value="True">
                                <Setter Property="Kind" Value="CheckCircle" />
                                <Setter Property="Foreground" Value="MediumSeaGreen" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>

            <TextBlock Text="{Binding DCTravelPage.TravelProgressText}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
